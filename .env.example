# Supabase Postgres
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Cloudflare R2 S3-compatible API credentials; use a token scoped to one bucket.
CLOUDFLARE_ACCOUNT_ID=replace-with-32-character-account-id
CLOUDFLARE_R2_BUCKET=your-private-bucket-name
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Optional; default is "default". Set to eu, fedramp, or us for jurisdictional buckets.
# CLOUDFLARE_R2_JURISDICTION=eu

# Generate separate random secrets of at least 32 characters:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=replace-with-random-32-byte-secret
RDR_EVENT_TOKEN=replace-with-a-different-random-32-byte-secret
